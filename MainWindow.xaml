<Window x:Class="GammaTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gamma" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" FontFamily="Consolas">

    <Window.Resources>
        <SolidColorBrush x:Key="Cyan" Color="#00E5FF"/>
        <DropShadowEffect x:Key="Glow" Color="#00E5FF" BlurRadius="14" ShadowDepth="0"/>

        <Style x:Key="Chip" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="#7FDCFF"/>
            <Setter Property="BorderBrush" Value="#12425F"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
                    <Setter Property="Foreground" Value="#EAFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Preset" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
                    <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                    <Setter Property="Background" Value="#1A00E5FF"/>
                    <Setter Property="Effect">
                        <Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/></Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Caption" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <Style x:Key="Bar" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="6" Background="{TemplateBinding Background}" Effect="{TemplateBinding Effect}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30">
                            <Border Height="6" Background="#0F1A26"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Bar}" Command="Slider.DecreaseLarge" Effect="{StaticResource Glow}">
                                        <RepeatButton.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#7C4DFF" Offset="0"/>
                                                <GradientStop Color="#00E5FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </RepeatButton.Background>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Bar}" Command="Slider.IncreaseLarge" Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Width="12" Height="26" CornerRadius="3" Background="{StaticResource Cyan}" Effect="{StaticResource Glow}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="24" Width="420" Padding="26,18,26,26" CornerRadius="14"
            Background="#07090F" BorderBrush="#12324A" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect Color="#00E5FF" BlurRadius="28" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" Content="✕" Click="OnClose" ToolTip="Close (resets gamma)"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" Content="—" Click="OnMinimize" ToolTip="Minimize"/>
                <TextBlock Text="// GAMMA" Foreground="{StaticResource Cyan}" FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="ValueText" Margin="0,18,0,14" FontSize="64" FontWeight="Bold" Foreground="#EAFFFF">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00E5FF" BlurRadius="24" ShadowDepth="0" Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>

            <Slider x:Name="GammaSlider" Minimum="0.5" Maximum="3" SmallChange="0.01" LargeChange="0.05"
                    IsMoveToPointEnabled="True" AutomationProperties.Name="Gamma"/>

            <DockPanel Margin="0,4,0,18" TextElement.Foreground="#5A8AA3" TextElement.FontSize="12">
                <TextBlock DockPanel.Dock="Right" Text="3,00"/>
                <TextBlock Text="0,50"/>
            </DockPanel>

            <UniformGrid x:Name="Presets" Columns="5"/>

            <DockPanel Margin="0,18,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="16,6" Content="RESET" Click="OnReset"/>
                <Button x:Name="UnlockButton" DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="16,6" Margin="0,0,8,0"
                        Content="UNLOCK" Click="OnUnlock" Visibility="Collapsed"
                        ToolTip="Lift Windows' gamma limit (needs admin, then sign out and back in)"/>
                <TextBlock x:Name="Status" Foreground="#FF5C8A" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
